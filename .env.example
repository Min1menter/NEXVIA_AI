# Copy to .env and fill in. NEVER commit .env.
# Use URL-safe characters in POSTGRES_PASSWORD (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
RADIOLOGIST_USER=radiologist
RADIOLOGIST_PASSWORD=
ADMIN_USER=admin
ADMIN_PASSWORD=
# Pin an exact Orthanc image tag for reproducible builds (see https://hub.docker.com/r/orthancteam/orthanc/tags)
ORTHANC_TAG=latest
